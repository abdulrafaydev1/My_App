<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollSettings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingTop="12dp"
    android:paddingBottom="96dp"
    android:paddingHorizontal="16dp">

    <LinearLayout
        android:id="@+id/layoutSettingsContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Custom AI Voice Alert Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCustomVoiceAlert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/surface_variant"
            app:cardBackgroundColor="@color/surface_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🗣️ Custom AI Voice Warning"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Spoken out loud via Android Text-To-Speech when you attempt to open a locked app."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvCurrentCustomVoice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@color/bg_primary"
                    android:padding="12dp"
                    android:text="&quot;Time is up! Put your phone down and get back to work!&quot;"
                    android:textColor="@color/accent_neon_blue"
                    android:textSize="13sp"
                    android:textStyle="italic" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEditCustomVoice"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="✏️ Edit Voice"
                        android:textColor="#0B0F19"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        app:cornerRadius="12dp"
                        app:backgroundTint="@color/accent_neon_blue" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTestCustomVoice"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="🔊 Test Voice"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        app:cornerRadius="12dp"
                        app:strokeWidth="1.5dp"
                        app:strokeColor="@color/accent_neon_blue"
                        app:backgroundTint="@color/surface_variant" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Maintenance Mode Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMaintenanceMode"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:text="🛠️ 5-Minute Maintenance Mode (PIN Required)"
            android:textColor="@color/accent_yellow"
            android:textStyle="bold"
            android:textSize="13sp"
            app:cornerRadius="14dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/accent_yellow"
            app:backgroundTint="@color/surface_card" />

        <!-- Add Custom App Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddCustomApp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:text="➕ Add Custom App to Shield"
            android:textColor="@color/accent_neon_blue"
            android:textStyle="bold"
            android:textSize="13sp"
            app:cornerRadius="14dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/accent_neon_blue"
            app:backgroundTint="@color/surface_card" />

        <!-- Developer Test Mode Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTestMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/surface_variant"
            app:cardBackgroundColor="@color/surface_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡ Developer Test Mode"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Temporarily reduces app limits to 2 minutes for testing."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchTestMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="@color/accent_yellow"
                    app:trackTint="@color/surface_variant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- System Permissions Section Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="🔒 System Service Permissions"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Usage Access Card (Row 1) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardUsageAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/surface_variant"
            app:cardBackgroundColor="@color/surface_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:id="@+id/imgUsageStatus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_check_circle"
                    app:tint="@color/status_green"
                    android:contentDescription="Usage Icon" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Usage Access"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvUsageStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="GRANTED"
                        android:textColor="@color/status_green"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGrantUsage"
                    android:layout_width="wrap_content"
                    android:minWidth="110dp"
                    android:maxWidth="145dp"
                    android:layout_height="40dp"
                    android:text="1. Grant Access"
                    android:textAllCaps="false"
                    android:textColor="#0B0F19"
                    android:textStyle="bold"
                    android:textSize="12.5sp"
                    android:paddingHorizontal="14dp"
                    app:cornerRadius="10dp"
                    app:backgroundTint="@color/accent_neon_blue" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Accessibility Service Card (Row 2) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/surface_variant"
            app:cardBackgroundColor="@color/surface_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:id="@+id/imgAccessibilityStatus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_check_circle"
                    app:tint="@color/status_green"
                    android:contentDescription="Accessibility Icon" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Accessibility Service"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvAccessibilityStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="ENABLED"
                        android:textColor="@color/status_green"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEnableAccessibility"
                    android:layout_width="wrap_content"
                    android:minWidth="110dp"
                    android:maxWidth="145dp"
                    android:layout_height="40dp"
                    android:text="2. Enable Service"
                    android:textAllCaps="false"
                    android:textColor="#0B0F19"
                    android:textStyle="bold"
                    android:textSize="12.5sp"
                    android:paddingHorizontal="14dp"
                    app:cornerRadius="10dp"
                    app:backgroundTint="@color/accent_neon_blue" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Overlay Permission Card (Row 3) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardOverlayPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/surface_variant"
            app:cardBackgroundColor="@color/surface_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:id="@+id/imgOverlayStatus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_check_circle"
                    app:tint="@color/status_green"
                    android:contentDescription="Overlay Icon" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Display Over Other Apps"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvOverlayStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="GRANTED"
                        android:textColor="@color/status_green"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGrantOverlay"
                    android:layout_width="wrap_content"
                    android:minWidth="110dp"
                    android:maxWidth="145dp"
                    android:layout_height="40dp"
                    android:text="3. Allow Overlay"
                    android:textAllCaps="false"
                    android:textColor="#0B0F19"
                    android:textStyle="bold"
                    android:textSize="12.5sp"
                    android:paddingHorizontal="14dp"
                    app:cornerRadius="10dp"
                    app:backgroundTint="@color/accent_neon_blue" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- App Version Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/surface_variant"
            app:cardBackgroundColor="@color/surface_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="InstaGuard Pro v12.1 - Premium Edition"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="AI Visual &amp; Focus Shield • YouTube / Instagram Style Dark UI • Zero Cloud Latency"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
