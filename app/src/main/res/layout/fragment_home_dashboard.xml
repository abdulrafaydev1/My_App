<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollDashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ig_bg_canvas"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingTop="12dp"
    android:paddingBottom="@dimen/ig_dock_bottom_clearance"
    android:paddingHorizontal="@dimen/ig_screen_padding_horizontal">

    <LinearLayout
        android:id="@+id/layoutDashboardContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 1. Hero Allowance & Timer Card (@drawable/bg_card_hero_accent — References B & E) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardOverallStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ig_card_spacing"
            app:cardCornerRadius="@dimen/ig_card_radius_large"
            app:cardElevation="0dp"
            app:strokeWidth="1.2dp"
            app:strokeColor="#40D8FF3E"
            app:cardBackgroundColor="@color/ig_bg_card">

            <LinearLayout
                android:id="@+id/layoutOverallStatusBg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_hero_accent"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/viewStatusDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_day_circle_active"
                        android:backgroundTint="@color/ig_accent_primary" />

                    <TextView
                        android:id="@+id/tvOverallStatusTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="AI FOCUS SHIELD ACTIVE"
                        android:textColor="@color/ig_accent_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_icon_circle_surface">

                        <ImageView
                            android:id="@+id/imgOverallStatus"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_shield_lock"
                            app:tint="@color/ig_accent_primary"
                            android:contentDescription="Status Icon" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Large Tabular Display Typography (36sp, sans-serif-black, #F5F7FA) -->
                <TextView
                    android:id="@+id/tvDailyRemaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="02h 00m 00s Left"
                    android:textColor="@color/ig_text_primary"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:id="@+id/tvOverallStatusDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Combined daily allowance across protected social apps."
                    android:textColor="@color/ig_text_secondary"
                    android:textSize="13sp" />

                <!-- Sleek Horizontal Progress Bar (#D8FF3E fill over #252A34 track) -->
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressHeroAllowance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:max="1000"
                    android:progress="850"
                    app:trackColor="#252A34"
                    app:indicatorColor="@color/ig_accent_primary"
                    app:trackCornerRadius="6dp"
                    app:trackThickness="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTotalScrollsToday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎬 Total Scrolls Today: 0"
                        android:textColor="@color/ig_accent_primary"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. 2-Column Bento Metric Row (Reference E Heart Rate / Workout Time Style) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ig_card_spacing"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- Left Bento Card: Today's Scrolls -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_card_surface"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Scrolls Today"
                        android:textColor="@color/ig_text_secondary"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_icon_circle_surface"
                        android:gravity="center"
                        android:text="🎬"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvBentoScrollsValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-black"
                    android:text="0"
                    android:textColor="@color/ig_accent_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Reels &amp; Shorts Scrolled"
                    android:textColor="@color/ig_text_secondary"
                    android:textSize="11.5sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Right Bento Card: Blocked / Auto-Skipped Interventions -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_card_surface"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Interventions"
                        android:textColor="@color/ig_text_secondary"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_icon_circle_surface"
                        android:gravity="center"
                        android:text="🛡️"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvBentoInterventionsValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-black"
                    android:text="0"
                    android:textColor="@color/ig_accent_amber"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Interventions Today"
                    android:textColor="@color/ig_text_secondary"
                    android:textSize="11.5sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3. Focus Streak & Discipline Score Bento Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFocusStreak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ig_card_spacing"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/ig_border_subtle"
            app:cardBackgroundColor="@color/ig_bg_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ig_card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvFocusStreak"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🔥 1-Day Active Streak"
                        android:textColor="@color/ig_accent_amber"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDisciplineRank"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="🏆 Grandmaster Focus"
                        android:textColor="@color/ig_accent_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDisciplineScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Discipline Score: 100%"
                    android:textColor="@color/ig_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressDisciplineScore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:progress="100"
                    app:trackColor="#252A34"
                    app:indicatorColor="@color/ig_accent_primary"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="7dp" />

                <TextView
                    android:id="@+id/tvStreakSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Maintain low scroll impulse to protect your streak."
                    android:textColor="@color/ig_text_secondary"
                    android:textSize="12.5sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4. Focus & Deep Work Action Card (Reference B Task Card Style) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDeepWorkMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ig_section_spacing"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/ig_border_subtle"
            app:cardBackgroundColor="@color/ig_bg_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ig_card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_circle_surface">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_timer"
                            app:tint="@color/ig_accent_primary"
                            android:contentDescription="@null" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Instant Deep Work &amp; Study Lock"
                            android:textColor="@color/ig_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDeepWorkStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Ready for deep focus sessions"
                            android:textColor="@color/ig_text_secondary"
                            android:textSize="12.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <com.instaguard.app.ui.widget.ElasticStretchButton
                        android:id="@+id/btnDeepWork1Hour"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="⚡ 1 Hr Focus"
                        android:textAllCaps="false"
                        android:textColor="@color/ig_text_on_accent"
                        android:textStyle="bold"
                        android:textSize="13.5sp"
                        app:cornerRadius="24dp"
                        app:returnToAnchorOnRelease="true"
                        app:backgroundTint="@color/ig_accent_primary" />

                    <com.instaguard.app.ui.widget.ElasticStretchButton
                        android:id="@+id/btnDeepWork2Hour"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="🚀 2 Hr Focus"
                        android:textAllCaps="false"
                        android:textColor="@color/ig_text_on_accent"
                        android:textStyle="bold"
                        android:textSize="13.5sp"
                        app:cornerRadius="24dp"
                        app:returnToAnchorOnRelease="true"
                        app:backgroundTint="@color/ig_accent_amber" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelStudyMode"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:visibility="gone"
                    android:text="✕ Cancel Active Study Lock"
                    android:textAllCaps="false"
                    android:textColor="@color/ig_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="22dp"
                    app:strokeColor="@color/ig_accent_danger"
                    app:strokeWidth="1dp"
                    app:backgroundTint="#202530" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 5. Tracked Apps & Custom App Shield Section Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="PROTECTED SOCIAL APPS"
            android:textColor="@color/ig_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <!-- Instagram Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardInstagram"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ig_card_spacing"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/ig_border_subtle"
            app:cardBackgroundColor="@color/ig_bg_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ig_card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_circle_surface">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_instagram"
                            app:tint="@color/ig_accent_primary"
                            android:contentDescription="@null" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvInstagramTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="Instagram"
                        android:textColor="@color/ig_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvInstagramBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="ALLOWED"
                        android:textColor="@color/ig_accent_primary"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressInstagram"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:max="1000"
                    app:trackColor="#252A34"
                    app:indicatorColor="@color/ig_accent_primary"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvInstagramTimer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="00:00:00.000"
                        android:textColor="@color/ig_accent_primary"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvInstagramLimit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="/ 30m"
                        android:textColor="@color/ig_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvInstagramStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="30m left"
                        android:textColor="@color/ig_text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvInstagramScrolls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="🎬 Today: 0 scrolls  •  🚫 Blocked: 0"
                    android:textColor="@color/ig_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- YouTube Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardYouTube"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ig_card_spacing"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/ig_border_subtle"
            app:cardBackgroundColor="@color/ig_bg_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ig_card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_circle_surface">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_reels_clapper"
                            app:tint="@color/ig_accent_amber"
                            android:contentDescription="@null" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvYouTubeTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="YouTube"
                        android:textColor="@color/ig_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvYouTubeBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="ALLOWED"
                        android:textColor="@color/ig_accent_primary"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressYouTube"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:max="1000"
                    app:trackColor="#252A34"
                    app:indicatorColor="@color/ig_accent_primary"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvYouTubeTimer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="00:00:00.000"
                        android:textColor="@color/ig_accent_primary"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvYouTubeLimit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="/ 30m"
                        android:textColor="@color/ig_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvYouTubeStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="30m left"
                        android:textColor="@color/ig_text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvYouTubeScrolls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="🎬 Today: 0 scrolls  •  🚫 Blocked: 0"
                    android:textColor="@color/ig_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Facebook Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFacebook"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ig_card_spacing"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/ig_border_subtle"
            app:cardBackgroundColor="@color/ig_bg_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ig_card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_circle_surface">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_shield"
                            app:tint="@color/ig_accent_primary"
                            android:contentDescription="@null" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvFacebookTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
