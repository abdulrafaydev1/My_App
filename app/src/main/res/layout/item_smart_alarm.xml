<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardAlarmRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/ig_card_spacing"
    app:cardBackgroundColor="@color/ig_bg_card"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/ig_border_subtle"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/ig_card_padding">

        <!-- Row 1: Large 32sp Bold Time, Next-Ring Countdown Pill & Master ON/OFF Switch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAlarmTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="06:30 AM"
                android:textColor="@color/ig_text_primary"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCountdownBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_pill_version"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Rings in 6h 45m"
                android:textColor="@color/ig_accent_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchAlarmEnabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:thumbTint="@color/ig_accent_primary"
                app:trackTint="#252A34" />
        </LinearLayout>

        <!-- Row 2: Label & Hard Sound Name -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAlarmLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🏷️ Morning Gym &amp; Deep Work"
                android:textColor="@color/ig_text_primary"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAlarmSound"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="🚨 Nuclear Air-Raid Siren"
                android:textColor="@color/ig_accent_amber"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 3: Circular Repeat Days Indicators (M T W T F S S — Reference B/E Calendar Strip Style) -->
        <LinearLayout
            android:id="@+id/layoutDaysPills"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pillMon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_day_circle_active"
                android:gravity="center"
                android:text="M"
                android:textColor="@color/ig_text_on_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pillTue"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_day_circle_active"
                android:gravity="center"
                android:text="T"
                android:textColor="@color/ig_text_on_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pillWed"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_day_circle_active"
                android:gravity="center"
                android:text="W"
                android:textColor="@color/ig_text_on_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pillThu"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_day_circle_active"
                android:gravity="center"
                android:text="T"
                android:textColor="@color/ig_text_on_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pillFri"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_day_circle_active"
                android:gravity="center"
                android:text="F"
                android:textColor="@color/ig_text_on_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pillSat"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_day_circle_inactive"
                android:gravity="center"
                android:text="S"
                android:textColor="@color/ig_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pillSun"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_day_circle_inactive"
                android:gravity="center"
                android:text="S"
                android:textColor="@color/ig_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 4: Feature Badges (Auto-Delete, Snooze, Vol, Voice) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBadgeAutoDelete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_input_surface"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="🗑️ Auto-Delete"
                android:textColor="@color/ig_accent_danger"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBadgeSnooze"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_input_surface"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="💤 5m"
                android:textColor="@color/ig_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvBadgeVolume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_input_surface"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="🔊 100%"
                android:textColor="@color/ig_accent_primary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvBadgeVoice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_surface"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="🗣️ Voice"
                android:textColor="@color/ig_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Divider line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="12dp"
            android:background="@color/ig_divider" />

        <!-- Row 5: Action Pill Buttons (Test, Edit, Delete) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTestAlarm"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="▶️ Test"
                android:textAllCaps="false"
                android:textColor="@color/ig_accent_amber"
                android:textStyle="bold"
                android:textSize="12sp"
                app:cornerRadius="20dp"
                app:strokeWidth="1dp"
                app:strokeColor="#40FF8A1E"
                app:backgroundTint="#202530" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditAlarm"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="✏️ Edit"
                android:textAllCaps="false"
                android:textColor="@color/ig_accent_primary"
                android:textStyle="bold"
                android:textSize="12sp"
                app:cornerRadius="20dp"
                app:strokeWidth="1dp"
                app:strokeColor="#40D8FF3E"
                app:backgroundTint="#202530" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteAlarm"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="🗑️ Delete"
                android:textAllCaps="false"
                android:textColor="@color/ig_accent_danger"
                android:textStyle="bold"
                android:textSize="12sp"
                app:cornerRadius="20dp"
                app:strokeWidth="1dp"
                app:strokeColor="#40FF2E54"
                app:backgroundTint="#202530" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
