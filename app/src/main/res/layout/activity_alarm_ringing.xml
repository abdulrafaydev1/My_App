<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutRingingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:keepScreenOn="true">

    <ScrollView
        android:id="@+id/layoutStage1Container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="36dp"
            android:paddingBottom="48dp">

            <!-- Alarm Status Header -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/viewRingingDot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/ic_launcher_background"
                    android:backgroundTint="@color/accent_red" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="HARDCORE SMART ALARM"
                    android:textColor="@color/accent_red"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />
            </LinearLayout>

            <!-- Live Digital Clock -->
            <TextView
                android:id="@+id/tvClockLive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="06:30:00 AM"
                android:textColor="@color/text_primary"
                android:textSize="40sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvDateLive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tuesday, October 20"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

            <!-- Alarm Label Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/accent_neon_blue"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvAlarmLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏷️ Wake Up Mission"
                        android:textColor="@color/accent_neon_blue"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/tvSoundTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="🚨 Nuclear Air-Raid Siren (Extreme)"
                        android:textColor="@color/accent_yellow"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/tvAutoDeleteBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_pill_version"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="🗑️ Auto-Delete After Ringing"
                        android:textColor="@color/accent_red"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Single Clean Stop / Dismiss Alarm Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStopAlarm"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:text="🛑 Stop / Dismiss Alarm"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp"
                app:cornerRadius="16dp"
                app:backgroundTint="@color/accent_red" />

            <!-- Snooze Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSnooze"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="💤 Snooze for 5 Min"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="14sp"
                app:cornerRadius="14dp"
                app:strokeColor="@color/accent_yellow"
                app:strokeWidth="1.5dp"
                app:backgroundTint="@color/surface_card" />

            <!-- Emergency / Test Stop Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmergencyStop"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="20dp"
                android:text="🛑 Stop Test"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                app:cornerRadius="10dp"
                app:strokeColor="@color/surface_variant"
                app:strokeWidth="1dp"
                app:backgroundTint="@color/bg_primary"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>
