<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ig_bg_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Dialog Header -->
        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="⏰ Set Hard Alarm"
            android:textColor="@color/ig_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Configure exact wake-up time, hardcore synthesizer, and repeat schedule."
            android:textColor="@color/ig_text_secondary"
            android:textSize="12.5sp" />

        <!-- Time Picker Container -->
        <TimePicker
            android:id="@+id/timePickerAlarm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:timePickerMode="spinner" />

        <!-- Alarm Label Input -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="🏷️ Alarm Label"
            android:textColor="@color/ig_text_primary"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etAlarmLabel"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_surface"
            android:hint="e.g. Morning Workout / Deep Work"
            android:inputType="textCapSentences"
            android:paddingHorizontal="14dp"
            android:textColor="@color/ig_text_primary"
            android:textColorHint="@color/ig_text_muted"
            android:textSize="14sp" />

        <!-- Repeat Days Selector -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="📅 Repeat Days"
            android:textColor="@color/ig_text_primary"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <!-- Quick Repeat Shortcuts -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickOneTime"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="One-Time"
                android:textAllCaps="false"
                android:textColor="@color/ig_text_primary"
                android:textSize="11.5sp"
                app:cornerRadius="19dp"
                app:backgroundTint="#202530" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickWeekdays"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Weekdays"
                android:textAllCaps="false"
                android:textColor="@color/ig_text_primary"
                android:textSize="11.5sp"
                app:cornerRadius="19dp"
                app:backgroundTint="#202530" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickEveryday"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="Everyday"
                android:textAllCaps="false"
                android:textColor="@color/ig_text_primary"
                android:textSize="11.5sp"
                app:cornerRadius="19dp"
                app:backgroundTint="#202530" />
        </LinearLayout>

        <!-- 7 Circular Toggle Buttons for Mon..Sun -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ToggleButton
                android:id="@+id/toggleMon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_day_circle_inactive"
                android:textOff="M"
                android:textOn="M"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ToggleButton
                android:id="@+id/toggleTue"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_day_circle_inactive"
                android:textOff="T"
                android:textOn="T"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ToggleButton
                android:id="@+id/toggleWed"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_day_circle_inactive"
                android:textOff="W"
                android:textOn="W"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ToggleButton
                android:id="@+id/toggleThu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_day_circle_inactive"
                android:textOff="T"
                android:textOn="T"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ToggleButton
                android:id="@+id/toggleFri"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_day_circle_inactive"
                android:textOff="F"
                android:textOn="F"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ToggleButton
                android:id="@+id/toggleSat"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_day_circle_inactive"
                android:textOff="S"
                android:textOn="S"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ToggleButton
                android:id="@+id/toggleSun"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_day_circle_inactive"
                android:textOff="S"
                android:textOn="S"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Delete After Ringing Switch Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#202530"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/ig_border_subtle"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🗑️ Delete After Ringing"
                        android:textColor="@color/ig_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Automatically removes this alarm once it rings and is dismissed"
                        android:textColor="@color/ig_text_secondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchDeleteAfterRinging"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="@color/ig_accent_danger"
                    app:trackTint="#252A34" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Hard Alarm Sound Selector -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="🔊 Hard Alarm Sound (12+ Mathematical Synthesizers)"
            android:textColor="@color/ig_text_primary"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spinnerAlarmSound"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_surface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPreviewSound"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:text="▶️ Preview"
                android:textAllCaps="false"
                android:textColor="@color/ig_accent_amber"
                android:textStyle="bold"
                android:textSize="12sp"
                app:cornerRadius="14dp"
                app:strokeWidth="1dp"
                app:strokeColor="#40FF8A1E"
                app:backgroundTint="#202530" />
        </LinearLayout>

        <!-- Snooze Duration Selector -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="💤 Snooze Timing"
            android:textColor="@color/ig_text_primary"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerSnooze"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_surface" />

        <!-- Extra Pro Switches -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔊 Force 100% Max Alarm Volume"
                    android:textColor="@color/ig_text_primary"
                    android:textSize="13sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchForceMaxVolume"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:thumbTint="@color/ig_accent_primary"
                    app:trackTint="#252A34" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📳 Heavy Earthquake Vibration"
                    android:textColor="@color/ig_text_primary"
                    android:textSize="13sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchHeavyVibration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:thumbTint="@color/ig_accent_primary"
                    app:trackTint="#252A34" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🗣️ AI Voice Label Announcement"
                    android:textColor="@color/ig_text_primary"
                    android:textSize="13sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchAiVoice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:thumbTint="@color/ig_accent_primary"
                    app:trackTint="#252A34" />
            </LinearLayout>
        </LinearLayout>

        <!-- Dialog Action Pill Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTestCurrentSettings"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="🧪 Test Now"
                android:textAllCaps="false"
                android:textColor="@color/ig_accent_amber"
                android:textStyle="bold"
                android:textSize="13sp"
                app:cornerRadius="24dp"
                app:strokeWidth="1dp"
                app:strokeColor="#40FF8A1E"
                app:backgroundTint="#202530" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelDialog"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="@color/ig_text_secondary"
                android:textSize="13sp"
                app:cornerRadius="24dp"
                app:backgroundTint="#202530" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveAlarm"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="💾 Save"
                android:textAllCaps="false"
                android:textColor="@color/ig_text_on_accent"
                android:textStyle="bold"
                android:textSize="13sp"
                app:cornerRadius="24dp"
                app:backgroundTint="@color/ig_accent_primary" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
