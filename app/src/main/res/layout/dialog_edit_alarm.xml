<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Dialog Header -->
        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏰ Set Hard Alarm"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Choose exact wake-up time, hardcore sound, and dismiss mission."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Time Picker Container -->
        <TimePicker
            android:id="@+id/timePickerAlarm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:timePickerMode="spinner" />

        <!-- Alarm Label Input -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="🏷️ Alarm Label"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etAlarmLabel"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:background="@color/surface_card"
            android:hint="e.g. Morning Workout / Deep Work"
            android:inputType="textCapSentences"
            android:paddingHorizontal="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Repeat Days Selector -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="📅 Repeat Days"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <!-- Quick Repeat Shortcuts -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickOneTime"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="One-Time"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                app:cornerRadius="8dp"
                app:backgroundTint="@color/surface_variant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickWeekdays"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Weekdays"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                app:cornerRadius="8dp"
                app:backgroundTint="@color/surface_variant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickEveryday"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Everyday"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                app:cornerRadius="8dp"
                app:backgroundTint="@color/surface_variant" />
        </LinearLayout>

        <!-- 7 Toggle Buttons for Mon..Sun -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ToggleButton
                android:id="@+id/toggleMon"
                android:layout_width="42dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_pill_version"
                android:textOff="Mon"
                android:textOn="Mon"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ToggleButton
                android:id="@+id/toggleTue"
                android:layout_width="42dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_pill_version"
                android:textOff="Tue"
                android:textOn="Tue"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ToggleButton
                android:id="@+id/toggleWed"
                android:layout_width="42dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_pill_version"
                android:textOff="Wed"
                android:textOn="Wed"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ToggleButton
                android:id="@+id/toggleThu"
                android:layout_width="42dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_pill_version"
                android:textOff="Thu"
                android:textOn="Thu"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ToggleButton
                android:id="@+id/toggleFri"
                android:layout_width="42dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_pill_version"
                android:textOff="Fri"
                android:textOn="Fri"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ToggleButton
                android:id="@+id/toggleSat"
                android:layout_width="42dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_pill_version"
                android:textOff="Sat"
                android:textOn="Sat"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ToggleButton
                android:id="@+id/toggleSun"
                android:layout_width="42dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_pill_version"
                android:textOff="Sun"
                android:textOn="Sun"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Delete After Ringing Switch Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/surface_variant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🗑️ Delete After Ringing"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Automatically deletes this alarm from your list once it rings and is dismissed"
                        android:textColor="@color/text_secondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchDeleteAfterRinging"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="@color/accent_red"
                    app:trackTint="@color/surface_variant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Hard Alarm Sound Selector -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="🔊 Hard Alarm Sound (12+ Mathematical Synthesizers)"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spinnerAlarmSound"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@color/surface_card" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPreviewSound"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:text="▶️ Preview"
                android:textColor="@color/accent_yellow"
                android:textStyle="bold"
                android:textSize="12sp"
                app:cornerRadius="10dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/accent_yellow"
                app:backgroundTint="@color/surface_variant" />
        </LinearLayout>

        <!-- Snooze Duration Selector -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="💤 Snooze Timing"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerSnooze"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@color/surface_card" />

        <!-- Wake-Up Dismiss Mission -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="🧠 Wake-Up Dismiss Mission"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerMission"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@color/surface_card" />

        <!-- Camera Scan Target Item -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="📷 Camera Scan Target Item"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerScanTargetItem"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@color/surface_card" />

        <!-- Extra Pro Switches -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔊 Force 100% Max Alarm Volume"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchForceMaxVolume"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:thumbTint="@color/accent_neon_blue"
                    app:trackTint="@color/surface_variant" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📳 Heavy Earthquake Vibration"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchHeavyVibration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:thumbTint="@color/accent_neon_blue"
                    app:trackTint="@color/surface_variant" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🗣️ AI Voice Label Announcement"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchAiVoice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:thumbTint="@color/accent_neon_blue"
                    app:trackTint="@color/surface_variant" />
            </LinearLayout>
        </LinearLayout>

        <!-- Dialog Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTestCurrentSettings"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="🧪 Test Now"
                android:textColor="@color/accent_yellow"
                android:textStyle="bold"
                android:textSize="13sp"
                app:cornerRadius="12dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/accent_yellow"
                app:backgroundTint="@color/surface_variant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelDialog"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:text="Cancel"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/surface_variant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveAlarm"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="💾 Save"
                android:textColor="#0B0F19"
                android:textStyle="bold"
                android:textSize="13sp"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/accent_neon_blue" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
