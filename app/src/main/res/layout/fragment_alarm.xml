<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollAlarm"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingTop="12dp"
    android:paddingBottom="96dp"
    android:paddingHorizontal="16dp">

    <LinearLayout
        android:id="@+id/layoutAlarmContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Hero Card — Quick Master Test & Status Banner -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAlarmHero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/surface_variant"
            app:cardBackgroundColor="@color/surface_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_alarm_tab"
                        app:tint="@color/accent_neon_blue"
                        android:contentDescription="Alarm Icon" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⏰ Hardcore Smart Alarm"
                            android:textColor="@color/text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvHeroAlarmStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="No active alarms scheduled"
                            android:textColor="@color/accent_neon_blue"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="12 piercing mathematical synthesizers, Math &amp; Tap wake-up missions, and auto-delete on ringing."
                    android:textColor="@color/text_secondary"
                    android:textSize="12.5sp" />

                <!-- Action Button 1: Create New Hard Alarm -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCreateAlarm"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:text="➕ Create New Hard Alarm"
                    android:textColor="#0B0F19"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    app:cornerRadius="14dp"
                    app:backgroundTint="@color/accent_neon_blue" />

                <!-- Action Button 2: Test Alarm & Everything Now -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTestEverythingNow"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:text="⚡ Test Alarm &amp; Everything Now"
                    android:textColor="#0B0F19"
                    android:textStyle="bold"
                    android:textSize="13.5sp"
                    app:cornerRadius="14dp"
                    app:backgroundTint="@color/accent_yellow" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Saved Alarms Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="📋 SAVED HARD ALARMS"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Empty State Container -->
        <LinearLayout
            android:id="@+id/layoutEmptyAlarms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_alarm_tab"
                app:tint="@color/text_secondary"
                android:alpha="0.5"
                android:contentDescription="Empty Alarms" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="No Alarms Configured"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tap '+ Create New Hard Alarm' to set up a wake-up mission!"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:gravity="center" />
        </LinearLayout>

        <!-- RecyclerView for Saved Alarms -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAlarms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_smart_alarm" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
