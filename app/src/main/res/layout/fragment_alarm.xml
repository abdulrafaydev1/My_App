<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollAlarm"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ig_bg_canvas"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingTop="12dp"
    android:paddingBottom="@dimen/ig_dock_bottom_clearance"
    android:paddingHorizontal="@dimen/ig_screen_padding_horizontal">

    <LinearLayout
        android:id="@+id/layoutAlarmContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Hero Card — Quick Master Test & Status Banner (References B & E) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAlarmHero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ig_section_spacing"
            app:cardCornerRadius="@dimen/ig_card_radius_large"
            app:cardElevation="0dp"
            app:strokeWidth="1.2dp"
            app:strokeColor="#40D8FF3E"
            app:cardBackgroundColor="@color/ig_bg_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_hero_accent"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_icon_circle_surface">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_alarm_tab"
                            app:tint="@color/ig_accent_primary"
                            android:contentDescription="Alarm Icon" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⏰ Hardcore Smart Alarm"
                            android:textColor="@color/ig_text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvHeroAlarmStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="No active alarms scheduled"
                            android:textColor="@color/ig_accent_primary"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="12 piercing mathematical synthesizers, reliable screen-off wakeup, and optional auto-delete on ringing."
                    android:textColor="@color/ig_text_secondary"
                    android:textSize="12.5sp" />

                <!-- Primary Action Pill Button: + Create New Hard Alarm (#D8FF3E with dark text #0B0D10) -->
                <com.instaguard.app.ui.widget.ElasticStretchButton
                    android:id="@+id/btnCreateAlarm"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="16dp"
                    android:text="+ Create New Hard Alarm"
                    android:textAllCaps="false"
                    android:textColor="@color/ig_text_on_accent"
                    android:textStyle="bold"
                    android:textSize="14.5sp"
                    app:cornerRadius="25dp"
                    app:returnToAnchorOnRelease="true"
                    app:backgroundTint="@color/ig_accent_primary" />

                <!-- Secondary Action Pill Button: ⚡ Test Alarm Now (#202530 with #FF8A1E accent) -->
                <com.instaguard.app.ui.widget.ElasticStretchButton
                    android:id="@+id/btnTestEverythingNow"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:text="⚡ Test Alarm Now"
                    android:textAllCaps="false"
                    android:textColor="@color/ig_accent_amber"
                    android:textStyle="bold"
                    android:textSize="13.5sp"
                    app:cornerRadius="24dp"
                    app:returnToAnchorOnRelease="true"
                    app:strokeWidth="1dp"
                    app:strokeColor="#40FF8A1E"
                    app:backgroundTint="#202530" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Saved Alarms Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="SAVED HARD ALARMS"
            android:textColor="@color/ig_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <!-- Empty State Container -->
        <LinearLayout
            android:id="@+id/layoutEmptyAlarms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_surface"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_icon_circle_surface">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_alarm_tab"
                    app:tint="@color/ig_accent_primary"
                    android:contentDescription="Empty Alarms" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="No Alarms Configured"
                android:textColor="@color/ig_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tap '+ Create New Hard Alarm' to schedule a wake-up alarm."
                android:textColor="@color/ig_text_secondary"
                android:textSize="13sp"
                android:gravity="center" />
        </LinearLayout>

        <!-- RecyclerView for Saved Alarms -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAlarms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_smart_alarm" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
