<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/ig_bg_canvas">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="18dp"
        android:paddingVertical="24dp">

        <!-- Top Pill Badge -->
        <LinearLayout
            android:id="@+id/layoutTopBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_shield"
                app:tint="@color/ig_accent_primary"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvLockBadgeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="INSTAGUARD FOCUS SHIELD"
                android:textColor="@color/ig_accent_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <!-- Centered Obsidian Bento Lock Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLockContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="26dp"
            app:cardElevation="0dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/ig_accent_danger"
            app:cardBackgroundColor="@color/ig_bg_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingVertical="26dp"
                android:paddingHorizontal="18dp">

                <!-- Pulsing Lock Icon Container -->
                <FrameLayout
                    android:id="@+id/frameLockIcon"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:background="@drawable/bg_icon_circle_surface"
                    android:padding="20dp">

                    <ImageView
                        android:id="@+id/imgLockIcon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/ig_accent_danger"
                        android:contentDescription="@string/lock_screen_title" />
                </FrameLayout>

                <!-- Dynamic Title -->
                <TextView
                    android:id="@+id/tvLockTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="sans-serif-black"
                    android:text="App is Locked!"
                    android:textAlignment="center"
                    android:textColor="@color/ig_text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <!-- Subtitle -->
                <TextView
                    android:id="@+id/tvLockSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:paddingHorizontal="12dp"
                    android:text="30-Minute limit reached. Take a 5-Hour focus break."
                    android:textAlignment="center"
                    android:textColor="@color/ig_text_secondary"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />

                <!-- Countdown Timer Container Box -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/ig_border_subtle"
                    app:cardBackgroundColor="#14171D">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="18dp"
                        android:paddingHorizontal="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="REMAINING FOCUS COOLDOWN"
                            android:textColor="@color/ig_text_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08" />

                        <!-- Countdown Display -->
                        <TextView
                            android:id="@+id/tvCountdownTimer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="monospace"
                            android:gravity="center"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:ellipsize="none"
                            android:text="04:59:59.980"
                            android:textColor="@color/ig_accent_danger"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            app:autoSizeTextType="uniform"
                            app:autoSizeMinTextSize="16sp"
                            app:autoSizeMaxTextSize="28sp"
                            app:autoSizeStepGranularity="1sp" />

                        <TextView
                            android:id="@+id/tvUnlockTimeEstimate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Unlocks at 08:30 PM"
                            android:textColor="@color/ig_accent_amber"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Blocked Attempts Today Badge -->
                <TextView
                    android:id="@+id/tvBlockedAttemptsBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_input_surface"
                    android:fontFamily="monospace"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="🚫 Blocked Attempts Today for App: 0"
                    android:textColor="@color/ig_accent_amber"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Motivational & Focus Quotes Bento Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMotivationalQuote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/ig_border_subtle"
            app:cardBackgroundColor="@color/ig_bg_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingHorizontal="18dp"
                android:paddingVertical="16dp">

                <TextView
                    android:id="@+id/tvMotivationalQuote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="“Discipline is choosing between what you want now and what you want most.”"
                    android:textAlignment="center"
                    android:textColor="@color/ig_text_primary"
                    android:textSize="13.5sp"
                    android:textStyle="italic"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:id="@+id/tvQuoteAuthor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="💡 FOCUS WISDOM • TAP FOR NEXT"
                    android:textColor="@color/ig_accent_primary"
                    android:textSize="10.5sp"
                    android:letterSpacing="0.08"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Primary Action Pill Button: Go Back to Home (#D8FF3E Volt-Lime with #0B0D10 dark text) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoHome"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:text="@string/btn_go_home"
            android:textAllCaps="false"
            android:textColor="@color/ig_text_on_accent"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/ig_accent_primary"
            app:cornerRadius="27dp"
            app:icon="@drawable/ic_home"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@color/ig_text_on_accent" />

        <!-- Secondary Emergency Bypass Pill Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEmergencyUnlock"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="16dp"
            android:text="🚨 Emergency 5-Min Unlock (1/Day)"
            android:textAllCaps="false"
            android:textColor="@color/ig_accent_danger"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="#202530"
            app:strokeColor="#40FF2E54"
            app:strokeWidth="1.2dp"
            app:cornerRadius="24dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
