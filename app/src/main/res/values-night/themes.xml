<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.InstaGuard" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent_neon_blue</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">#0B0F19</item>
        <item name="colorSecondary">@color/accent_yellow</item>
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:navigationBarColor">@color/surface_card</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="materialCardViewStyle">@style/Widget.InstaGuard.Card</item>
    </style>

    <style name="Widget.InstaGuard.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/border_subtle</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.InstaGuard.Card.Hero">
        <item name="cardCornerRadius">20dp</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="strokeColor">@color/border_card</item>
    </style>
</resources>
